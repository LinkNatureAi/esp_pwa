// 1. GLOBAL CONSTANTS & PRE-COMPILED REGEX
// ==========================================
const LOGO_URL = "https://avatars.githubusercontent.com/u/108781856?v=4";
const CACHE_NAME = 'linknature-prod-v4-master'; // Cache Updated
const CACHE_TTL = 86400; // 24 Hours
const ADMIN_SECRET = "superadmin123";
const SIX_MONTHS_TTL = 15552000; 

// Regex optimizations (Security Validation)
const REGEX_IP_CLEANUP = /[^0-9\.]/g;
const REGEX_VALID_IP = /^(\d{1,3}\.){3}\d{1,3}$/;

// Security Headers
const SECURE_HEADERS = {
  "X-Content-Type-Options": "nosniff",
  "X-Frame-Options": "DENY"
};

// Reusable Headers
const HEADERS = {
  html: { "Content-Type": "text/html;charset=UTF-8", ...SECURE_HEADERS },
  json: { "Content-Type": "application/json", "Cache-Control": `public, max-age=${CACHE_TTL}`, ...SECURE_HEADERS },
  manifest: { "Content-Type": "application/manifest+json", "Cache-Control": "no-store, no-cache", ...SECURE_HEADERS },
  sw: { "Content-Type": "application/javascript", "Cache-Control": "no-cache", ...SECURE_HEADERS },
  plain: { "Content-Type": "text/plain", ...SECURE_HEADERS },
  redirect: { "Cache-Control": "no-store, no-cache", "Pragma": "no-cache", ...SECURE_HEADERS }
};

// ==========================================
// 2. HELPER FUNCTIONS
// ==========================================
function normalizeId(id) {
  if (!id) return "";
  return String(id).toLowerCase().replace(/[^a-z0-9]/g, '').trim();
}

function escapeHTML(str) {
  if (!str) return "LinkNatureAI";
  return String(str).substring(0, 30).replace(/[&<>"']/g, function(m) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
  });
}

// ==========================================
// 3. ULTRA-LOW MEMORY SECURITY SYSTEM
// ==========================================
const rateLimitMap = new Map();
const RATE_LIMIT_WINDOW = 60000; 
const MAX_REQUESTS = 150;

function isTrafficSafe(ip, request) {
  const url = new URL(request.url);
  const ua = (request.headers.get('user-agent') || '').toLowerCase();
  
  if (!url.pathname.includes('/update')) {
    if (['nmap', 'masscan', 'zgrab', 'python', 'curl', 'wget'].some(bot => ua.includes(bot))) return false;
  }

  if (rateLimitMap.size > 5000) rateLimitMap.clear();
  const now = Date.now();
  const record = rateLimitMap.get(ip);

  if (record) {
    if (now > record.resetTime) {
      rateLimitMap.set(ip, { count: 1, resetTime: now + RATE_LIMIT_WINDOW });
      return true;
    }
    if (record.count >= MAX_REQUESTS) return false;
    record.count++;
    return true;
  }

  rateLimitMap.set(ip, { count: 1, resetTime: now + RATE_LIMIT_WINDOW });
  return true;
}

