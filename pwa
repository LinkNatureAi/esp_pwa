  if (url.pathname.includes("/api/") || url.pathname.includes("/update")) {
    return e.respondWith(fetch(e.request).catch(() => new Response("System Offline", {status: 503})));
  }
 
  e.respondWith(
    caches.match(e.request).then(cached => {
      return cached || fetch(e.request).catch(() => new Response("Network Unavailable", {status: 503}));
    })
  );
});
`;

// ==========================================
// 6. MAIN WORKER ROUTING LOGIC
// ==========================================
export default {
  // YEH API AUR WEB TRAFFIC HANDLE KAREGA
  async fetch(request, env, ctx) {
    try {
      const url = new URL(request.url);
      const cache = caches.default;
      const clientIP = request.headers.get('CF-Connecting-IP') || 'unknown';

      // 1. Security Check
      if (!isTrafficSafe(clientIP, request)) {
        return new Response("Too Many Requests. Please wait a moment.", { status: 429, headers: HEADERS.plain });
      }

      // 2. Prevent Large Payload Attacks
      if (request.method === "POST") {
        const len = request.headers.get("content-length");
        if (len && parseInt(len) > 1024) return new Response("Payload Large", { status: 413 });
      }

      if (!env.ESP_DATA) return new Response("Configuration Error: KV missing.", { status: 500 });

      // ---> A. Admin Route (Get Devices Count) <---
      if (request.method === "GET" && url.pathname === "/api/admin/devices") {
        if (url.searchParams.get("key") !== ADMIN_SECRET) {
          return new Response("Unauthorized Access!", { status: 401, headers: HEADERS.plain });
        }
        let count = 0; let listComplete = false; let cursor;
        while (!listComplete) {
          const list = await env.ESP_DATA.list({ cursor });
          count += list.keys.length;
          listComplete = list.list_complete;
          cursor = list.cursor;
        }
        return new Response(JSON.stringify({ status: "Success", total_active_devices: count }), { headers: HEADERS.json });
      }

      // ---> B. Update IP (ESP Device Ping) <---
      if (request.method === "POST" && url.pathname.includes("update")) {
        const data = await request.json().catch(() => null);
        if (!data?.id || !data?.ip) return new Response("Missing Data", { status: 400 });

        const cleanId = normalizeId(data.id);
        const cleanIp = String(data.ip).replace(REGEX_IP_CLEANUP, '');

        if (!cleanId || !REGEX_VALID_IP.test(cleanIp)) {
          return new Response("Invalid Format", { status: 400 });
        }
       
        const existingIp = await env.ESP_DATA.get(cleanId);
       
        // NEW FEATURE: 3 Months (7776000 seconds) Expiration TTL
        if (existingIp !== cleanIp) {
          await env.ESP_DATA.put(cleanId, cleanIp, { expirationTtl: 7776000 });
          return new Response("IP Updated & Synced", { status: 200 });
        } else {
          await env.ESP_DATA.put(cleanId, cleanIp, { expirationTtl: 7776000 });
          return new Response("IP Unchanged, Ping Acknowledged", { status: 200 });
        }
      }

      // ---> C. Cache Check (Bypass API) <---
      if (request.method === "GET" && !url.pathname.includes("/api/")) {
        let cachedResponse = await cache.match(request);
        if (cachedResponse) return cachedResponse;
      }

      // ---> D. Serve SW & Manifest <---
      if (request.method === "GET" && url.pathname === "/sw.js") {
        const response = new Response(SW_CONTENT, { headers: HEADERS.js });
        ctx.waitUntil(cache.put(request, response.clone()));
        return response;
      }
      if (request.method === "GET" && url.pathname.startsWith("/manifest.json")) {
        const id = normalizeId(url.searchParams.get("id"));
        const response = new Response(generateManifest(id), { headers: HEADERS.json });
        ctx.waitUntil(cache.put(request, response.clone()));
        return response;
      }

      // ---> E. API: Get Direct IP for Smart Cache <---
      if (request.method === "GET" && url.pathname.startsWith("/api/get-ip/")) {
        const idParts = url.pathname.split("/");
        const id = normalizeId(idParts[idParts.length - 1]);
        const ip = await env.ESP_DATA.get(id);
       
        if (!ip) {
          return new Response(JSON.stringify({ error: "No IP found" }), { status: 404, headers: HEADERS.json });
        }
        const cleanIP = ip.replace(REGEX_IP_CLEANUP, '');
        return new Response(JSON.stringify({ ip: cleanIP }), { status: 200, headers: HEADERS.json });
      }

      // ---> F. Redirect Logic (Fallback Real-time Link) <---
      if (request.method === "GET" && url.pathname.startsWith("/api/connect/")) {
        const idParts = url.pathname.split("/");
        const id = normalizeId(idParts[idParts.length - 1]);
        const ip = await env.ESP_DATA.get(id);
       
        if (!ip) {
           return new Response(`
             <!DOCTYPE html>
             <html>
               <head>
                 <meta http-equiv="refresh" content="5">
                 <meta name="viewport" content="width=device-width, initial-scale=1">
                 <style>
                   body { background: #0a0a0a; color: #00ffcc; font-family: sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; text-align: center; }
                   .loader { border: 4px solid rgba(0,255,204,0.1); border-top: 4px solid #00ffcc; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin-bottom: 20px;}
                   @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
                   p { opacity: 0.7; font-size: 14px; }
                 </style>
               </head>
               <body>
                 <div class="loader"></div>
                 <h2>Syncing Device...</h2>
                 <p>Waiting for secure connection. Retrying automatically...</p>
               </body>
             </html>
           `, { status: 404, headers: HEADERS.html });
        }
       
        const cleanIP = ip.replace(REGEX_IP_CLEANUP, '');
        return new Response(null, {
          status: 302,
          headers: {
            "Location": `http://${cleanIP}`,
            ...HEADERS.redirect
          }
        });
      }

      // ---> G. Render HTML Interface (UI) <---
      if (request.method === "GET") {
        let id = normalizeId(url.pathname.replace(/^\/+/g, ''));
        if (id === "favicon.ico") return new Response(null, { status: 204 });
        if (!id) return new Response("Access Denied", { status: 400, headers: HEADERS.plain });
       
        return new Response(generateHTML(id), { headers: HEADERS.html });
      }
     
      return new Response("Route Not Found", { status: 404 });
    } catch (err) {
      return new Response(`System Exception: ${err.message}`, { status: 500 });
    }
  },

  // ==========================================
  // 7. AUTO BACKGROUND CLEANUP (CRON TRIGGER)
  // ==========================================
  // Yeh function background mein chalega aur double keys/junk data delete karega
  async scheduled(event, env, ctx) {
    ctx.waitUntil(this.runAutoCleanup(env));
  },

  async runAutoCleanup(env) {
    if (!env.ESP_DATA) return;

    let cursor;
    let listComplete = false;
    const seenIps = new Set();

    while (!listComplete) {
      const list = await env.ESP_DATA.list({ cursor });
      
      for (const key of list.keys) {
        const id = key.name;
        const ip = await env.ESP_DATA.get(id);
        
        // 1. Agar ID format galat hai ya uppercase letters hain -> Delete
        if (id !== id.toLowerCase() || /[^a-z0-9]/.test(id)) {
          await env.ESP_DATA.delete(id);
          continue;
        }
        
        // 2. Agar IP already kisi aur device ki save ho chuki hai (Duplicate) -> Delete
        if (seenIps.has(ip)) {
          await env.ESP_DATA.delete(id);
        } else {
          seenIps.add(ip);
        }
      }
      
      listComplete = list.list_complete;
      cursor = list.cursor;
    }
  }
};
