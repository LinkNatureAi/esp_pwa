const SW_CONTENT = `
const CACHE_NAME = '${CACHE_NAME}';
const ASSETS = ["${LOGO_URL}"];

self.addEventListener('install', e => {
  self.skipWaiting();
  e.waitUntil(caches.open(CACHE_NAME).then(cache => cache.addAll(ASSETS)).catch(() => {}));
});

self.addEventListener('activate', e => {
  e.waitUntil(
    caches.keys().then(keys => Promise.all(
      keys.filter(key => key !== CACHE_NAME).map(key => caches.delete(key))
    )).then(() => self.clients.claim())
  );
});

self.addEventListener('fetch', e => {
  const url = new URL(e.request.url);

  if (url.hostname.endsWith('.local') || /^(\\d{1,3}\\.){3}\\d{1,3}$/.test(url.hostname)) {
    return;
  }

  if (url.pathname.includes("/api/") || url.pathname.includes("/update")) {
    return e.respondWith(fetch(e.request).catch(() => new Response("System Offline", {status: 503})));
  }

  // ULTRA FAST UI LOAD: Cached HTML loads immediately
  if (e.request.mode === 'navigate' || e.request.destination === 'document') {
    e.respondWith(
      caches.match(e.request).then(cachedResponse => {
        const fetchPromise = fetch(e.request).then(networkResponse => {
          caches.open(CACHE_NAME).then(cache => cache.put(e.request, networkResponse.clone()));
          return networkResponse;
        }).catch(() => cachedResponse); 
        return cachedResponse || fetchPromise; 
      })
    );
    return;
  }
 
  e.respondWith(caches.match(e.request).then(cached => cached || fetch(e.request)));
});
`;

// ==========================================
// 6. MAIN WORKER ROUTING LOGIC
// ==========================================
export default {
  async fetch(request, env, ctx) {
    try {
      if (!['GET', 'POST', 'HEAD', 'OPTIONS'].includes(request.method)) {
        return new Response("Method Not Allowed", { status: 405, headers: HEADERS.plain });
      }

      const url = new URL(request.url);
      const cache = caches.default;
      const clientIP = request.headers.get('CF-Connecting-IP') || 'unknown';

      if (!isTrafficSafe(clientIP, request)) {
        return new Response("Too Many Requests. Please wait.", { status: 429, headers: HEADERS.plain });
      }

      if (request.method === "POST") {
        const len = request.headers.get("content-length");
        if (len && parseInt(len) > 1024) return new Response("Payload Large", { status: 413 });
      }

      if (!env.ESP_DATA) return new Response("Configuration Error: KV missing.", { status: 500 });

      if (request.method === "GET" && url.pathname === "/api/admin/devices") {
        if (url.searchParams.get("key") !== ADMIN_SECRET) return new Response("Unauthorized", { status: 401 });
        let count = 0; let listComplete = false; let cursor;
        while (!listComplete) {
          const list = await env.ESP_DATA.list({ cursor });
          count += list.keys.length;
          listComplete = list.list_complete;
          cursor = list.cursor;
        }
        return new Response(JSON.stringify({ status: "Success", total_active_devices: count }), { headers: HEADERS.json });
      }

      if (request.method === "POST" && url.pathname.includes("update")) {
        const data = await request.json().catch(() => null);
        if (!data?.id || !data?.ip) return new Response("Missing Data", { status: 400 });

        const cleanId = normalizeId(data.id);
        const cleanIp = String(data.ip).replace(REGEX_IP_CLEANUP, '');

        if (!cleanId || !REGEX_VALID_IP.test(cleanIp)) return new Response("Invalid Format", { status: 400 });
        
        const existingIp = await env.ESP_DATA.get(cleanId);
        await env.ESP_DATA.put(cleanId, cleanIp, { expirationTtl: SIX_MONTHS_TTL });
        
        return new Response(existingIp !== cleanIp ? "IP Updated & Synced" : "IP Unchanged, Ping Acknowledged", { status: 200 });
      }

      if (request.method === "GET" && url.pathname === "/sw.js") {
        return new Response(SW_CONTENT, { headers: HEADERS.sw });
      }
      if (request.method === "GET" && url.pathname.startsWith("/manifest.json")) {
        const id = normalizeId(url.searchParams.get("id"));
        const projectName = url.searchParams.get("p") || "LinkNatureAI";
        return new Response(generateManifest(id, projectName), { headers: HEADERS.json });
      }

      if (request.method === "GET" && url.pathname.startsWith("/api/get-ip/")) {
        const idParts = url.pathname.split("/");
        const id = normalizeId(idParts[idParts.length - 1]);
        const ip = await env.ESP_DATA.get(id);
        if (!ip) return new Response(JSON.stringify({ error: "No IP found" }), { status: 404, headers: HEADERS.json });
        return new Response(JSON.stringify({ ip: ip.replace(REGEX_IP_CLEANUP, '') }), { status: 200, headers: HEADERS.json });
      }

      if (request.method === "GET" && url.pathname.startsWith("/api/connect/")) {
        const idParts = url.pathname.split("/");
        const id = normalizeId(idParts[idParts.length - 1]);
        const ip = await env.ESP_DATA.get(id);
        
        if (!ip) {
           return new Response(`<!DOCTYPE html><html><head><meta http-equiv="refresh" content="5"><meta name="viewport" content="width=device-width, initial-scale=1"><style>body { background: #0a0a0a; color: #00ffcc; font-family: sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; text-align: center; } .loader { border: 4px solid rgba(0,255,204,0.1); border-top: 4px solid #00ffcc; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin-bottom: 20px;} @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } } p { opacity: 0.7; font-size: 14px; }</style></head><body><div class="loader"></div><h2>Syncing Device...</h2><p>Waiting for secure connection. Retrying automatically...</p></body></html>`, { status: 404, headers: HEADERS.html });
        }
        return new Response(null, { status: 302, headers: { "Location": `http://${ip.replace(REGEX_IP_CLEANUP, '')}`, ...HEADERS.redirect } });
      }

      if (request.method === "GET") {
        let id = normalizeId(url.pathname.replace(/^\/+/g, '').split('?')[0]);
        if (id === "favicon.ico") return new Response(null, { status: 204 });
        if (!id) return new Response("Access Denied", { status: 400, headers: HEADERS.plain });
        
        const projectName = url.searchParams.get("p") || "LinkNatureAI";
        
        // Fetch Server IP to inject (Saves 1 API call on Frontend)
        const serverIp = await env.ESP_DATA.get(id) || "";
        const cleanServerIp = serverIp.replace(REGEX_IP_CLEANUP, '');

        return new Response(generateHTML(id, projectName, cleanServerIp), { headers: HEADERS.html });
      }
      
      return new Response("Route Not Found", { status: 404 });
    } catch (err) {
      return new Response(`System Exception: ${err.message}`, { status: 500 });
    }
  },

  // ==========================================
  // 7. AUTO BACKGROUND CLEANUP 
  // ==========================================
  async scheduled(event, env, ctx) {
    ctx.waitUntil(this.runAutoCleanup(env));
  },

  async runAutoCleanup(env) {
    if (!env.ESP_DATA) return;
    let cursor; let listComplete = false; const seenIps = new Set();
    while (!listComplete) {
      const list = await env.ESP_DATA.list({ cursor });
      for (const key of list.keys) {
        const id = key.name;
        const ip = await env.ESP_DATA.get(id);
        if (id !== id.toLowerCase() || /[^a-z0-9]/.test(id) || seenIps.has(ip)) {
          await env.ESP_DATA.delete(id);
        } else {
          seenIps.add(ip);
        }
      }
      listComplete = list.list_complete; cursor = list.cursor;
    }
  }
};
